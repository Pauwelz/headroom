@* One Time off bar of a Person. The grid owns the drag state and the writes.
   This component draws the bar and raises events. *@
@* One segment per visible day, so a pointer-down knows its day. *@
<div @ref="_bar" class="bar timeoff" style="@Style" title="@Tip" tabindex="@(CanEdit ? 0 : null)" role="@(CanEdit ? "group" : null)" aria-label="@(CanEdit ? Description : null)"
     @oncontextmenu="OpenMenuAsync" @oncontextmenu:preventDefault="@CanEdit">
    @foreach (var day in Days)
    {
        <span class="seg @(CanEdit ? "editable" : null)" @onpointerdown='e => PressAsync(DragMode.Move, day, e)'>
            @if (CanEdit && day == Bar.StartDate)
            {
                <i class="edge l" @onpointerdown='e => PressAsync(DragMode.Start, day, e)' @onpointerdown:stopPropagation="true"></i>
            }
            @if (CanEdit && day == Bar.EndDate)
            {
                <i class="edge r" @onpointerdown='e => PressAsync(DragMode.End, day, e)' @onpointerdown:stopPropagation="true"></i>
            }
        </span>
    }
    @* The row is the Time off row, so the bar shows only the half-day marks. *@
    <span class="text" aria-hidden="true">
        <span>@(TimeOffChanges.FirstDayIsHalf(Bar) ? "½" : "")</span><span>@(TimeOffChanges.LastDayIsHalf(Bar) ? "½" : "")</span>
    </span>
    @if (!CanEdit)
    {
        <span class="sr-only">@Description</span>
    }
    else
    {
        @* No visible activator: a right-click, or the Menu key or Shift+F10 on the focused bar, opens the menu. *@
        <MudMenu @ref="_menu" Dense="true" PositionAtCursor="true" Style="@Controls.StartStyle" OpenChanged="MenuOpenChangedAsync">
            <ChildContent>
                <MudMenuItem OnClick="() => OnEdit.InvokeAsync()">Edit</MudMenuItem>
                @if (TimeOffChanges.IsSingleDay(Bar))
                {
                    <MudMenuItem OnClick='() => OnChange.InvokeAsync(TimeOffChanges.SingleDay(Bar, DayPartName.Morning))'>Morning</MudMenuItem>
                    <MudMenuItem OnClick='() => OnChange.InvokeAsync(TimeOffChanges.SingleDay(Bar, DayPartName.Afternoon))'>Afternoon</MudMenuItem>
                    <MudMenuItem OnClick='() => OnChange.InvokeAsync(TimeOffChanges.SingleDay(Bar, "full"))'>Full day</MudMenuItem>
                }
                else
                {
                    <MudMenuItem OnClick="() => OnChange.InvokeAsync(TimeOffChanges.FirstDay(Bar, !TimeOffChanges.FirstDayIsHalf(Bar)))">
                        First day: @(TimeOffChanges.FirstDayIsHalf(Bar) ? "Full day" : "Half day")
                    </MudMenuItem>
                    <MudMenuItem OnClick="() => OnChange.InvokeAsync(TimeOffChanges.LastDay(Bar, !TimeOffChanges.LastDayIsHalf(Bar)))">
                        Last day: @(TimeOffChanges.LastDayIsHalf(Bar) ? "Full day" : "Half day")
                    </MudMenuItem>
                }
                <MudMenuItem OnClick="() => OnDelete.InvokeAsync()">Delete</MudMenuItem>
            </ChildContent>
        </MudMenu>
    }
</div>

@code {
    [Parameter, EditorRequired] public ScheduleTimeOff Bar { get; set; } = default!;

    /// <summary>The Person of the row. Screen readers need it: they do not see the row label next to the bar.</summary>
    [Parameter, EditorRequired] public string PersonName { get; set; } = "";

    /// <summary>The viewer may change this Time off. The server enforces it too.</summary>
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>The visible days of the bar, also while a drag runs. The grid column style places the bar.</summary>
    [Parameter] public IEnumerable<DateOnly> Days { get; set; } = [];
    [Parameter] public string Style { get; set; } = "";

    /// <summary>Where the menu anchor goes, so it stays in the days that fit the width.</summary>
    [Parameter] public BarControls Controls { get; set; }

    [Parameter] public EventCallback<(DragMode Mode, DateOnly Day)> OnPress { get; set; }
    [Parameter] public EventCallback<TimeOffRequest> OnChange { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private MudMenu? _menu;
    private ElementReference _bar;

    // True while a menu that the keyboard opened is open: when it closes, focus returns to the bar.
    private bool _openedByKeyboard;

    // MouseEventArgs.Button of a right-click. A contextmenu event from the keyboard has another value.
    private const long RightButton = 2;

    private string Tip => $"{DisplayDate.Format(Bar.StartDate)} ({Bar.StartPart}) - {DisplayDate.Format(Bar.EndDate)} ({Bar.EndPart})";

    private string Description => $"Time off, {PersonName}, {Tip}";

    // Only the left button drags. A right-click opens the bar menu, as on an Allocation bar.
    private Task PressAsync(DragMode mode, DateOnly day, PointerEventArgs e) =>
        e.Button == 0 ? OnPress.InvokeAsync((mode, day)) : Task.CompletedTask;

    private Task OpenMenuAsync(MouseEventArgs e)
    {
        _openedByKeyboard = e.Button != RightButton;
        return CanEdit && _menu is not null ? _menu.OpenMenuAsync(e) : Task.CompletedTask;
    }

    private async Task MenuOpenChangedAsync(bool open)
    {
        if (open || !_openedByKeyboard) return;
        _openedByKeyboard = false;
        await _bar.FocusAsync();
    }
}
