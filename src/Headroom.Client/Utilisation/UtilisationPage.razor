@page "/utilisation"
@using Headroom.Client.Schedule
@using Headroom.Client.Utilisation
@inject UtilisationApi Api
@inject TimeProvider Time

<PageTitle>Utilisation - Headroom</PageTitle>

<div class="d-flex align-center gap-2 mb-3 flex-wrap">
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="Previous quarter" OnClick="@(() => PageAsync(-1))" />
    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="Next quarter" OnClick="@(() => PageAsync(1))" />
    <MudText Typo="Typo.subtitle1">@_range.Label</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">@DisplayDate.Format(_range.From) - @DisplayDate.Format(_range.To)</MudText>
</div>

<MudTabs Elevation="0" Rounded="true">
    <MudTabPanel Text="Heatmap">
        @if (_data is null)
        {
            <LoadingSkeleton />
        }
        else
        {
            <UtilisationHeatmap Data="_data" MeId="Me.Id" Today="_today" OnPeriod="PeriodAsync" />
        }
    </MudTabPanel>
    <MudTabPanel Text="Table">
        @if (_data is null)
        {
            <LoadingSkeleton />
        }
        else
        {
            <UtilisationTable Data="_data" MeId="Me.Id" />
        }
    </MudTabPanel>
</MudTabs>

@code {
    [CascadingParameter] public MeResponse Me { get; set; } = default!;

    private DateOnly _today;
    private UtilisationRange _range = default!;
    private string _period = "week";
    private UtilisationResponse? _data;

    protected override async Task OnInitializedAsync()
    {
        _today = ScheduleRange.TodayInBrussels(Time);
        _range = UtilisationRange.Default(_today);
        await LoadAsync();
    }

    private async Task PageAsync(int direction)
    {
        _range = _range.Page(direction);
        await LoadAsync();
    }

    private async Task PeriodAsync(string period)
    {
        _period = period;
        await LoadAsync();
    }

    private async Task LoadAsync() => _data = await Api.GetAsync(_range, _period);
}
