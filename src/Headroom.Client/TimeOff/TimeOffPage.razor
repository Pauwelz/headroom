@page "/time-off"
@using Headroom.Client.Schedule
@inject ScheduleApi Api
@inject TimeProvider Time

<PageTitle>Time off - Headroom</PageTitle>

<div class="d-flex align-center gap-2 mb-3 flex-wrap">
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="Previous" OnClick="@(() => ShowAsync(_month.AddMonths(-1)))" />
    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="Next" OnClick="@(() => ShowAsync(_month.AddMonths(1)))" />
    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => ShowAsync(Today))">Today</MudButton>
    <MudText Typo="Typo.h6">@DisplayDate.Month(_month, false)</MudText>
</div>

@if (_failed is not null)
{
    <MudAlert Severity="Severity.Warning">@_failed</MudAlert>
}
else if (_weeks is null)
{
    <LoadingSkeleton />
}
else
{
    <div class="calendar">
        @foreach (var name in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
        {
            <div class="head">@name</div>
        }
        @foreach (var cell in _weeks.SelectMany(w => w))
        {
            <div class="day @(cell.InMonth ? "" : "outside") @(cell.Weekend ? "weekend" : "") @cell.DayOff?.ShadeClass">
                <div class="number">@cell.Date.Day</div>
                @if (cell.DayOff is { } off)
                {
                    <div class="day-off">@off.Name</div>
                }
                @foreach (var entry in cell.Entries)
                {
                    <div class="entry">@entry.Name@(entry.Part is null ? "" : $" ({entry.Part})")</div>
                }
            </div>
        }
    </div>
}

@code {
    private DateOnly _month;
    private IReadOnlyList<IReadOnlyList<CalendarCell>>? _weeks;
    private string? _failed;

    private DateOnly Today => ScheduleRange.TodayInBrussels(Time);

    protected override Task OnInitializedAsync() => ShowAsync(Today);

    private async Task ShowAsync(DateOnly month)
    {
        _month = new DateOnly(month.Year, month.Month, 1);
        var (from, to) = TimeOffCalendar.VisibleRange(_month);
        var requested = _month;
        try
        {
            var data = await Api.GetAsync(from, to);
            // A slower earlier load must not replace a newer month.
            if (requested != _month) return;
            _weeks = TimeOffCalendar.Weeks(_month, data);
            _failed = null;
        }
        catch (HttpRequestException)
        {
            if (requested == _month) _failed = "The Time off calendar did not load. Try again.";
        }
    }
}
