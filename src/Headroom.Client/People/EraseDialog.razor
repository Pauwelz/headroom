@inject PeopleApi Api

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }
            <MudText>Erase the personal details of <b>@Person.Name</b>?</MudText>
            <MudText Typo="Typo.body2">
                The name and the email are removed. The Planner flag is removed. Contracts, Time off and Allocations stay,
                under the name <b>Former Person N</b>. N is the next free number of this Instance.
            </MudText>
            <MudText Typo="Typo.body2">
                The result is not anonymous. Other data can still point to this Person. You cannot undo this. The Person cannot be rehired.
            </MudText>
            <MudCheckBox T="bool" @bind-Value="_understood" Label="I understand" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="@(_busy || !_understood)" OnClick="EraseAsync">Erase</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public PersonResponse Person { get; set; } = default!;

    private bool _understood;
    private string? _error;
    private bool _busy;

    private async Task EraseAsync()
    {
        _busy = true;
        try
        {
            await Api.EraseAsync(Person.Id);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException e) { _error = e.Message; }
        _busy = false;
    }
}
