@inject PeopleApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

@* Employment card. Add the next lifecycle buttons inside the MudStack below:
   Erase personal details. Each button is a ReasonTooltip around a MudButton. *@
<MudPaper Class="pa-4">
    <MudText Typo="Typo.h6">Employment</MudText>
    <MudText Typo="Typo.body1" Class="mt-2">@EmploymentText.Sentence(Person)</MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mt-3">
        <ReasonTooltip Reason="@SetLockReason">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(SetLockReason is not null)"
                       OnClick="SetEndDateAsync">@(Person.EndDate is null ? "Set end date" : "Change end date")</MudButton>
        </ReasonTooltip>
        <ReasonTooltip Reason="@RemoveLockReason">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(RemoveLockReason is not null)"
                       OnClick="RemoveEndDateAsync">Remove end date</MudButton>
        </ReasonTooltip>
        <ReasonTooltip Reason="@RehireLockReason">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(RehireLockReason is not null)"
                       OnClick="RehireAsync">Rehire</MudButton>
        </ReasonTooltip>
        <ReasonTooltip Reason="@_deleteLockReason">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="@(_deleteLockReason is not null)"
                       OnClick="DeleteAsync">Delete</MudButton>
        </ReasonTooltip>
        <ReasonTooltip Reason="@EraseLockReason">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="@(EraseLockReason is not null)"
                       OnClick="EraseAsync">Erase personal details</MudButton>
        </ReasonTooltip>
    </MudStack>
    <MudText Typo="Typo.caption" Class="mt-3" Style="display:block">
        Last changed by @EmploymentText.ChangedBy(Person.LastChangedBy, Everyone)
        at @DisplayDate.FormatTimestamp(Person.DateModified)
    </MudText>
</MudPaper>

@code {
    [Parameter, EditorRequired] public PersonResponse Person { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<PersonResponse> Everyone { get; set; } = default!;

    // Raised after any change, so the page loads the list again.
    [Parameter] public EventCallback Changed { get; set; }

    // The server computes every lock reason.
    private string? SetLockReason => Person.Locks.SetEndDate;
    private string? RemoveLockReason => Person.Locks.RemoveEndDate;
    private string? RehireLockReason => Person.Locks.Rehire;
    private string? EraseLockReason => Person.Locks.Erase;

    // Only the server knows what refers to the Person. Ask again for each new version of the Person.
    private const string Checking = "Checking what refers to this Person.";
    private string? _deleteLockReason = Checking;
    private (Guid, DateTimeOffset) _checked;

    protected override async Task OnParametersSetAsync()
    {
        if (_checked == (Person.Id, Person.DateModified)) return;
        _checked = (Person.Id, Person.DateModified);
        _deleteLockReason = Checking;
        try { _deleteLockReason = await Api.DeleteReasonAsync(Person.Id); }
        catch (ApiException e) { _deleteLockReason = e.Message; }
    }

    private async Task RehireAsync()
    {
        var dialog = await Dialogs.ShowAsync<RehireDialog>("Rehire",
            new DialogParameters<RehireDialog> { { x => x.Person, Person } }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled) await Changed.InvokeAsync();
    }

    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Delete Person",
            $"Delete {Person.Name} and their Contracts? This cannot be undone.", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;
        try { await Api.DeleteAsync(Person.Id); }
        catch (ApiException e) { Snackbar.Add(e.Message, Severity.Error); }
        await Changed.InvokeAsync();
    }

    private async Task EraseAsync()
    {
        var dialog = await Dialogs.ShowAsync<EraseDialog>("Erase personal details",
            new DialogParameters<EraseDialog> { { x => x.Person, Person } }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled) await Changed.InvokeAsync();
    }

    private async Task SetEndDateAsync()
    {
        var dialog = await Dialogs.ShowAsync<EndDateDialog>(Person.EndDate is null ? "Set end date" : "Change end date",
            new DialogParameters<EndDateDialog> { { x => x.Person, Person } }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result)!.Canceled) await Changed.InvokeAsync();
    }

    private async Task RemoveEndDateAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Remove end date",
            $"Remove the end date {DisplayDate.Format(Person.EndDate)} of {Person.Name}?", yesText: "Remove", cancelText: "Cancel");
        if (confirmed != true) return;
        try { await Api.RemoveEndDateAsync(Person.Id); }
        catch (ApiException e) { Snackbar.Add(e.Message, Severity.Error); }
        await Changed.InvokeAsync();
    }
}
