@page "/settings"
@inject SessionApi Session
@inject SettingsApi Api
@inject NavigationManager Navigation

<PageTitle>Settings</PageTitle>

@if (!Me.IsPlanner)
{
    <MudAlert Severity="Severity.Info">Only Planners see Settings.</MudAlert>
    return;
}

<MudText Typo="Typo.h4" Class="mb-4">Settings</MudText>

<div class="settings">
    <nav class="settings-nav" aria-label="Settings sections">
        <MudText Typo="Typo.subtitle2">Company</MudText>
        <a href="settings#company-name">Company name</a>
        <a href="settings#days-off">Company days off</a>
        <MudText Typo="Typo.subtitle2" Class="mt-3">Access and integrations</MudText>
        <a href="settings#tokens">Access tokens @Badge(_expiringSoon, SettingsSummary.TokensExpiringSoonLabel(_expiringSoon))</a>
        <a href="settings#apps">Connected apps</a>
        <a href="settings#connections">Connections</a>
        <a href="settings#webhooks">Webhooks @Badge(_failedEventCount, SettingsSummary.FailedEventsLabel(_failedEventCount))</a>
    </nav>

    <div class="settings-body">
        <MudText Typo="Typo.h5" Class="mb-2">Company</MudText>

        <SettingsSection Id="company-name" Title="Company name" Summary="@(_company ?? "…")" @bind-Expanded="_companyOpen">
            <MudText Typo="Typo.body2" Class="mb-2">The name shows on the login page, in the app bar and as the sender of the login email.</MudText>
            @if (_companyError is not null)
            {
                <SettingsAlert OnClose="() => _companyError = null">@_companyError</SettingsAlert>
            }
            <div class="d-flex align-center gap-2">
                <MudTextField @bind-Value="_companyEdit" Label="Company name" MaxLength="200" Immediate="true"
                              Required="true" RequiredError="Enter a name." />
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveCompanyAsync"
                           Disabled="@(string.IsNullOrWhiteSpace(_companyEdit) || _companyEdit.Trim() == _company)">Save</MudButton>
            </div>
        </SettingsSection>

        <CompanyDaysOffSection />

        <MudText Typo="Typo.h5" Class="mb-2 mt-6">Access and integrations</MudText>

        <AccessTokensSection ExpiringSoonChanged="count => _expiringSoon = count" />

        <ConnectedAppsSection OnDeleted="() => _connections?.ReloadAsync() ?? Task.CompletedTask" />

        <ConnectionsSection @ref="_connections" />

        <WebhooksSection FailedEventsChanged="count => _failedEventCount = count" />
    </div>
</div>

@code {
    [CascadingParameter] public MeResponse Me { get; set; } = default!;

    private bool _companyOpen;
    private string? _company;
    private string _companyEdit = "";
    private string? _companyError;
    private int _expiringSoon;
    private int _failedEventCount;
    private ConnectionsSection? _connections;

    // The nav badge shows the number. Screen readers hear the label instead.
    private static RenderFragment Badge(int count, string label) => count == 0 ? _ => { } :
        @<span><span class="badge" aria-hidden="true">@count</span><span class="sr-only">, @label</span></span>;

    protected override async Task OnInitializedAsync()
    {
        if (!Me.IsPlanner) return;
        _company = await Session.GetCompanyNameAsync();
        _companyEdit = _company ?? "";
    }

    private async Task SaveCompanyAsync()
    {
        _companyError = await Api.ChangeCompanyNameAsync(_companyEdit);
        // Reload, so the app bar shows the new name too.
        if (_companyError is null) Navigation.Refresh(forceReload: true);
    }
}
